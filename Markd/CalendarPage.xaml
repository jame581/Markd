<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:c="clr-namespace:Markd.Controls"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.CalendarPage"
             x:Name="RootPage"
             x:DataType="vm:CalendarViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <m:MediumTopAppBar Title="{loc:Tr Calendar_Title}" />

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,0,16,20" Spacing="18">

                <Border Style="{StaticResource M3Card}" StrokeShape="RoundRectangle 20" Padding="14,18">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Padding="4,0">
                            <Label Text="{Binding MonthTitle}" FontFamily="FigtreeSemiBold" FontSize="18" VerticalOptions="Center" />
                            <c:IconButton Grid.Column="1" Glyph="Back" Size="36" IconSize="18" Command="{Binding PreviousMonthCommand}" />
                            <c:IconButton Grid.Column="2" Glyph="Forward" Size="36" IconSize="18" Command="{Binding NextMonthCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="3">
                            <Grid.Resources>
                                <Style TargetType="Label" BasedOn="{StaticResource SecondaryText}">
                                    <Setter Property="FontFamily" Value="FigtreeSemiBold" />
                                    <Setter Property="FontSize" Value="11.5" />
                                    <Setter Property="HorizontalTextAlignment" Value="Center" />
                                </Style>
                            </Grid.Resources>
                            <Label Grid.Column="0" Text="{loc:Tr Calendar_Short_Mon}" />
                            <Label Grid.Column="1" Text="{loc:Tr Calendar_Short_Tue}" />
                            <Label Grid.Column="2" Text="{loc:Tr Calendar_Short_Wed}" />
                            <Label Grid.Column="3" Text="{loc:Tr Calendar_Short_Thu}" />
                            <Label Grid.Column="4" Text="{loc:Tr Calendar_Short_Fri}" />
                            <Label Grid.Column="5" Text="{loc:Tr Calendar_Short_Sat}" />
                            <Label Grid.Column="6" Text="{loc:Tr Calendar_Short_Sun}" />
                        </Grid>

                        <VerticalStackLayout Spacing="3" BindableLayout.ItemsSource="{Binding Weeks}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarWeek">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="3"
                                          BindableLayout.ItemsSource="{Binding Days}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CalendarDayCell">
                                                <Border Grid.Column="{Binding Column}" HeightRequest="44" StrokeShape="RoundRectangle 22"
                                                        BackgroundColor="Transparent">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <VerticalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="Center">
                                                        <Label Text="{Binding DayText}" FontFamily="FigtreeMedium" FontSize="14"
                                                               HorizontalOptions="Center">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsToday}" Value="True">
                                                                    <Setter Property="FontFamily" Value="FigtreeBold" />
                                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                        <HorizontalStackLayout Spacing="2.5" HeightRequest="5" HorizontalOptions="Center"
                                                                               BindableLayout.ItemsSource="{Binding CompactDots}">
                                                            <BindableLayout.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CalendarDot">
                                                                    <Ellipse WidthRequest="5" HeightRequest="5" Fill="{Binding Color}" />
                                                                </DataTemplate>
                                                            </BindableLayout.ItemTemplate>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="9">
                    <Label Text="{loc:Tr Calendar_ComingUp}" Style="{StaticResource M3SectionHeader}" Padding="4,0" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding ComingUp}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalendarComingUpItem">
                                <Border Style="{StaticResource M3Card}" Padding="16,13">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenOccasionCommand, x:DataType=ContentPage}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <c:EmojiAvatar Size="38" EmojiSize="17" LightAlpha="0.15" DarkAlpha="0.26"
                                                       Emoji="{Binding Emoji}" ColorHex="{Binding ColorHex}" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Label}" Style="{StaticResource M3RowTitle}" FontSize="15.5" />
                                            <Label Text="{Binding Sub}" Style="{StaticResource M3RowSub}" FontSize="12.5" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding RemainText}"
                                               FontFamily="PlexMonoMedium" FontSize="14" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{loc:Tr Calendar_ComingUpEmpty}"
                           Style="{StaticResource M3RowSub}" FontSize="12.5" Padding="4,0"
                           IsVisible="{Binding HasComingUp, Converter={StaticResource InvertBool}}" />
                    <Label Text="{loc:Tr Calendar_DotsLegend}"
                           Style="{StaticResource M3RowSub}" FontSize="12" Padding="4,2" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <m:BottomNavBar x:Name="NavBar" Grid.Row="2" Selected="calendar" />
    </Grid>
</ContentPage>
