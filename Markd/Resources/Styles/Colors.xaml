<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Markd palette. Light value first, dark second, via AppThemeBinding in Styles.xaml. -->
    <Color x:Key="PageBackgroundLight">#F5F5FA</Color>
    <Color x:Key="PageBackgroundDark">#0B0F14</Color>
    <Color x:Key="SurfaceCardLight">#FFFFFF</Color>
    <Color x:Key="SurfaceCardDark">#1B212A</Color>
    <Color x:Key="SurfaceCardPressedLight">#ECECF2</Color>
    <Color x:Key="SurfaceCardPressedDark">#232A34</Color>
    <Color x:Key="CardBorderLight">#E3E3EA</Color>
    <Color x:Key="CardBorderDark">#2A313C</Color>

    <Color x:Key="AccentFillLight">#6F63C9</Color>
    <Color x:Key="AccentFillDark">#8B7FE8</Color>
    <Color x:Key="AccentBorderColor">#6F63C9</Color>
    <Color x:Key="AccentTextLight">#5A4FB0</Color>
    <Color x:Key="AccentTextDark">#A79CF0</Color>
    <Color x:Key="AccentTintLight">#EDEBFB</Color>
    <Color x:Key="AccentTintDark">#241F3D</Color>

    <Color x:Key="DangerLight">#D9484F</Color>
    <Color x:Key="DangerDark">#E2585F</Color>

    <Color x:Key="TextPrimaryLight">#1C1E22</Color>
    <Color x:Key="TextPrimaryDark">#F5F6F7</Color>
    <Color x:Key="TextSecondaryLight">#6B6F76</Color>
    <Color x:Key="TextSecondaryDark">#8A8F98</Color>
    <Color x:Key="TextTertiaryLight">#9A9EA6</Color>
    <Color x:Key="TextTertiaryDark">#5C626C</Color>

    <!-- Platform chrome -->
    <Color x:Key="WindowChromeLight">#EFEEF4</Color>
    <Color x:Key="WindowChromeDark">#141A21</Color>
    <Color x:Key="NavBarSurfaceLight">#EFEDF6</Color>
    <Color x:Key="NavBarSurfaceDark">#161C24</Color>
    <Color x:Key="PrimaryContainerLight">#E7E3FA</Color>
    <Color x:Key="PrimaryContainerDark">#2E2758</Color>
    <Color x:Key="OnPrimaryContainerLight">#2E265F</Color>
    <Color x:Key="OnPrimaryContainerDark">#E3DEFA</Color>
    <Color x:Key="SurfaceContainerHighLight">#F0EEF7</Color>
    <Color x:Key="SurfaceContainerHighDark">#232A34</Color>
    <Color x:Key="OnPrimaryLight">#FFFFFF</Color>
    <Color x:Key="OnPrimaryDark">#14102E</Color>
    <Color x:Key="InverseSurfaceLight">#2E3138</Color>
    <Color x:Key="InverseSurfaceDark">#E7E8EC</Color>
    <Color x:Key="InverseOnSurfaceLight">#F2F1F6</Color>
    <Color x:Key="InverseOnSurfaceDark">#1C1E22</Color>
    <Color x:Key="InversePrimaryLight">#C9BFFF</Color>
    <Color x:Key="InversePrimaryDark">#5A4FB0</Color>

    <!-- Translucent layers used on the Android tonal cards and on dialog scrims -->
    <Color x:Key="OnContainerChipLight">#1A2E265F</Color>
    <Color x:Key="OnContainerChipDark">#1FFFFFFF</Color>
    <Color x:Key="OnContainerTrackLight">#292E265F</Color>
    <Color x:Key="OnContainerTrackDark">#29FFFFFF</Color>
    <Color x:Key="RippleLight">#121C1E22</Color>
    <Color x:Key="RippleDark">#1AFFFFFF</Color>
    <Color x:Key="DialogScrimLight">#761C1E28</Color>
    <Color x:Key="DialogScrimDark">#A806080C</Color>
    <Color x:Key="DesktopScrim">#700A0C12</Color>
    <!-- Desktop accent button under the pointer: AccentFill at 108% brightness -->
    <Color x:Key="AccentFillHoverLight">#786BD9</Color>
    <Color x:Key="AccentFillHoverDark">#9689FA</Color>
    <SolidColorBrush x:Key="DesktopShadowBrush" Color="#42000000" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#CC6F63C9" />
    <Color x:Key="WindowCloseHover">#C42B1C</Color>

    <!-- MAUI template keys kept so stock control styles still resolve -->
    <Color x:Key="Primary">#6F63C9</Color>
    <Color x:Key="PrimaryDark">#8B7FE8</Color>
    <Color x:Key="PrimaryDarkText">#F5F6F7</Color>
    <Color x:Key="Secondary">#EDEBFB</Color>
    <Color x:Key="SecondaryDarkText">#A79CF0</Color>
    <Color x:Key="Tertiary">#5A4FB0</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

</ResourceDictionary>
