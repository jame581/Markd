<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:domain="clr-namespace:Markd.Core.Domain;assembly=Markd.Core"
             x:Class="Markd.MainPage"
             Title="Markd">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <Button Grid.Row="0" Text="Add Occasion" Command="{Binding AddCommand}" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Occasions}"
                        SelectionMode="Single"
                        SelectionChanged="OnOccasionSelected">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="6">
                    <Label Text="No occasions yet." FontSize="18" FontAttributes="Bold" />
                    <Label Text="Tap 'Add Occasion' to create your first tracker." />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="domain:Occasion">
                    <Frame Padding="12" Margin="0,4" BorderColor="#DDDDDD">
                        <VerticalStackLayout Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Emoji}" FontSize="20" />
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="PINNED" IsVisible="{Binding IsPinned}" FontAttributes="Bold" TextColor="#0A7C2F" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Direction}" />
                            <Label Text="{Binding AnchorDate, StringFormat='Anchor: {0:D}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
