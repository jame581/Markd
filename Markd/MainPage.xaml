<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:c="clr-namespace:Markd.Controls"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.MainPage"
             x:Name="RootPage"
             x:DataType="vm:OccasionListViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <m:MediumTopAppBar Title="Markd">
            <c:IconButton x:Name="OverflowButton" Glyph="Dots" Clicked="OnOverflowClicked" IsVisible="{Binding HasOccasions}" />
        </m:MediumTopAppBar>

        <!-- Populated -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding UnpinnedGroups}"
                        IsGrouped="True"
                        SelectionMode="None"
                        IsVisible="{Binding HasOccasions}"
                        VerticalScrollBarVisibility="Never"
                        Margin="16,0">

            <CollectionView.Header>
                <Grid Padding="0,0,0,2">
                    <Border Style="{StaticResource M3TonalCard}"
                            StrokeShape="RoundRectangle 20"
                            Padding="20"
                            IsVisible="{Binding HasFeaturedOccasion}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFeaturedTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <c:EmojiAvatar Size="32" EmojiSize="16" LightAlpha="0.15" DarkAlpha="0.26"
                                               Emoji="{Binding FeaturedSummary.Emoji}"
                                               ColorHex="{Binding FeaturedSummary.ColorHex}" />
                                <Label Grid.Column="1"
                                       Text="{Binding FeaturedSummary.Title}"
                                       Style="{StaticResource M3OnContainer}"
                                       FontFamily="FigtreeSemiBold" FontSize="17"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="9,5"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource OnContainerChipLight}, Dark={StaticResource OnContainerChipDark}}"
                                        VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5">
                                        <c:SvgIcon Glyph="Pin" Size="13" VerticalOptions="Center"
                                                   Color="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                                        <Label Text="{loc:Tr Home_Pinned}" Style="{StaticResource M3OnContainer}"
                                               FontFamily="FigtreeSemiBold" FontSize="11" CharacterSpacing="0.8"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <HorizontalStackLayout Spacing="9">
                                <Label Text="{Binding FeaturedSummary.DisplayDays}"
                                       Style="{StaticResource M3OnContainer}"
                                       FontFamily="FigtreeExtraBold" FontSize="64" CharacterSpacing="-0.56"
                                       LineHeight="0.9" />
                                <Label Text="{Binding FeaturedSummary.UnitLabel}"
                                       Style="{StaticResource M3OnContainer}"
                                       FontFamily="FigtreeSemiBold" FontSize="19"
                                       Opacity="0.72" VerticalOptions="End" Margin="0,0,0,10" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding FeaturedBreakdown}"
                                   Style="{StaticResource M3OnContainer}"
                                   FontFamily="PlexMonoMedium" FontSize="13" Opacity="0.78" />

                            <VerticalStackLayout Spacing="8" Margin="0,2,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding FeaturedSummary.NextHeading}"
                                           Style="{StaticResource M3OnContainer}"
                                           FontFamily="FigtreeSemiBold" FontSize="13"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1"
                                           Text="{Binding FeaturedSummary.NextStatus}"
                                           Style="{StaticResource M3OnContainer}"
                                           FontFamily="PlexMonoMedium" FontSize="12.5" Opacity="0.75" />
                                </Grid>
                                <c:ProgressTrack HeightRequest="6"
                                                 Progress="{Binding FeaturedSummary.NextProgress}"
                                                 TrackColor="{AppThemeBinding Light={StaticResource OnContainerTrackLight}, Dark={StaticResource OnContainerTrackDark}}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </CollectionView.Header>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="vm:OccasionGroup">
                    <Label Text="{Binding CategoryName}"
                           Style="{StaticResource M3SectionHeader}"
                           Margin="4,18,0,8" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:OccasionSummary">
                    <Border Style="{StaticResource M3Card}"
                            Padding="16,14"
                            Margin="0,0,0,8"
                            MinimumHeightRequest="68">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.OpenDetailCommand, x:DataType=ContentPage}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <c:EmojiAvatar Size="40" EmojiSize="18" LightAlpha="0.15" DarkAlpha="0.26"
                                           Emoji="{Binding Emoji}" ColorHex="{Binding ColorHex}"
                                           VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}" Style="{StaticResource M3RowTitle}" />
                                <Label Text="{Binding AnchorLabel}" Style="{StaticResource M3RowSub}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                <Label Text="{Binding DisplayDays}"
                                       FontFamily="FigtreeBold" FontSize="20"
                                       HorizontalOptions="End" />
                                <Label Text="{Binding UnitLabel}"
                                       Style="{StaticResource M3RowSub}"
                                       FontSize="10.5" CharacterSpacing="0.8" TextTransform="Uppercase"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="96" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- First run -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsEmpty}"
                             Spacing="18"
                             Padding="44,0,44,70"
                             VerticalOptions="Center">
            <Border WidthRequest="100" HeightRequest="100"
                    StrokeShape="RoundRectangle 50"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}">
                <c:SvgIcon Glyph="MarkBig" Size="42" HorizontalOptions="Center" VerticalOptions="Center"
                           Color="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
            </Border>
            <Label Text="{loc:Tr Home_EmptyTitle}"
                   FontFamily="FigtreeSemiBold" FontSize="22"
                   HorizontalTextAlignment="Center" />
            <Label Text="{loc:Tr Home_EmptyHint}"
                   Style="{StaticResource M3RowSub}"
                   FontSize="15" LineHeight="1.25"
                   HorizontalTextAlignment="Center" />
            <Border HeightRequest="52"
                    StrokeShape="RoundRectangle 26"
                    Padding="26,0"
                    Margin="0,4,0,0"
                    HorizontalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                    <c:SvgIcon Glyph="Plus" Size="20" VerticalOptions="Center"
                               Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                    <Label Text="{loc:Tr Home_AddFirst}"
                           FontFamily="FigtreeSemiBold" FontSize="16" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                </HorizontalStackLayout>
            </Border>
            <Label Text="{loc:Tr Home_EmptyFootnote}"
                   Style="{StaticResource M3RowSub}"
                   Opacity="0.8"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <m:ExtendedFab Grid.Row="1"
                       Text="{loc:Tr Home_NewOccasion}"
                       Command="{Binding AddCommand}"
                       IsVisible="{Binding HasOccasions}"
                       Margin="0,0,16,16" />

        <m:BottomNavBar x:Name="NavBar" Grid.Row="2" Selected="home" />
    </Grid>
</ContentPage>
