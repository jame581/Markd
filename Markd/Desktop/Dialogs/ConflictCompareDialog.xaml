<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Desktop.Dialogs.ConflictCompareDialog">
    <!-- Both versions of one record side by side, over the conflict list -->
    <Border x:Name="Card" Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 10" WidthRequest="560">
        <Grid RowDefinitions="Auto,*,1,Auto">
            <Label x:Name="TitleLabel" Padding="26,24,26,8" Style="{StaticResource DeskDialogTitle}" LineBreakMode="WordWrap" />
            <ScrollView Grid.Row="1">
                <Grid x:Name="Table" ColumnDefinitions="*,*" ColumnSpacing="18" Padding="26,0,26,22" />
            </ScrollView>
            <BoxView Grid.Row="2" HeightRequest="1" />
            <Grid Grid.Row="3" Padding="26,18,26,22" ColumnDefinitions="*,Auto"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Button Grid.Column="1" Text="{loc:Tr Common_Close}" Style="{StaticResource DeskTonalButton}" Clicked="OnCloseClicked" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
