<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:domain="clr-namespace:Markd.Core.Domain;assembly=Markd.Core"
             xmlns:c="clr-namespace:Markd.Controls"
             xmlns:dc="clr-namespace:Markd.Desktop.Controls"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Desktop.Dialogs.OccasionFormDialog"
             x:DataType="vm:OccasionFormViewModel">
    <!-- New / edit occasion as a ContentDialog: 560 wide, radius 12, over a scrim -->
    <Border x:Name="Card" Style="{StaticResource DeskCard}" WidthRequest="560">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <VerticalStackLayout Padding="26,20,26,4" Spacing="4">
                <Label Text="{Binding Header}" Style="{StaticResource DeskDialogTitle}" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource DeskSubtitle}" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="26,10,26,14" Spacing="14">

                    <!-- Live preview: the count the occasion will read -->
                    <Border StrokeShape="RoundRectangle 9" Padding="14,9"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentTintLight}, Dark={StaticResource AccentTintDark}}">
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                            <c:EmojiAvatar Emoji="{Binding Emoji}" ColorHex="{Binding ColorHex}" Size="34" EmojiSize="17" CornerRadius="9"
                                           LightAlpha="0.2" DarkAlpha="0.3" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding PreviewDays}" FontFamily="FigtreeBold" FontSize="22" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                            <Label Grid.Column="2" Text="{Binding PreviewCaption}" FontSize="13" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
                        </Grid>
                    </Border>

                    <!-- Emoji picker button beside the title; the choices open underneath -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{loc:Tr Form_Emoji}" Style="{StaticResource DeskFieldLabel}" />
                                <dc:HoverSurface WidthRequest="38" HeightRequest="38" CornerRadius="8" NormalKey="PageBackground" HoverKey="SurfaceCardPressed"
                                                 StrokeKey="CardBorder" SelectedKey="AccentTint" SelectedStrokeKey="AccentBorderColor"
                                                 IsSelected="{Binding IsVisible, Source={x:Reference EmojiPanel}, x:DataType=dc:EmojiPalette}"
                                                 ToolTipProperties.Text="{loc:Tr Form_ChooseEmoji}" Clicked="OnEmojiButtonClicked">
                                    <Label Text="{Binding Emoji}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                                </dc:HoverSurface>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="{loc:Tr Form_Title}" Style="{StaticResource DeskFieldLabel}" />
                                <Border Style="{StaticResource DeskInput}">
                                    <Entry x:Name="TitleEntry" Text="{Binding Title}" Placeholder="{loc:Tr Form_TitlePlaceholder}" FontSize="14"
                                           Completed="OnTitleCompleted" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <dc:EmojiPalette x:Name="EmojiPanel" IsVisible="False" ShowAll="True" Columns="12"
                                         Choices="{x:Static vm:OccasionFormViewModel.EmojiChoices}" SelectedEmoji="{Binding Emoji}"
                                         EmojiPicked="OnEmojiPicked" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{loc:Tr Form_Category}" Style="{StaticResource DeskFieldLabel}" />
                            <Border Style="{StaticResource DeskInput}" Padding="4,0">
                                <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" FontSize="14"
                                        ItemDisplayBinding="{Binding Name, x:DataType=domain:Category}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Direction: a two-item segmented control, never a dropdown -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:Tr Form_Direction}" Style="{StaticResource DeskFieldLabel}" />
                            <Border Style="{StaticResource DeskInput}" Padding="3">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="3">
                                    <dc:HoverSurface CornerRadius="6" HoverKey="SurfaceCardPressed" SelectedKey="AccentFill"
                                                     IsSelected="{Binding IsSinceSelected}" Command="{Binding SetDirectionCommand}" CommandParameter="Since">
                                        <Label Text="{loc:Tr Form_CountingSince}" FontFamily="FigtreeSemiBold" FontSize="12.5" HorizontalOptions="Center" VerticalOptions="Center"
                                               InputTransparent="True" Style="{StaticResource SecondaryText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsSinceSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </dc:HoverSurface>
                                    <dc:HoverSurface Grid.Column="1" CornerRadius="6" HoverKey="SurfaceCardPressed" SelectedKey="AccentFill"
                                                     IsSelected="{Binding IsUntilSelected}" Command="{Binding SetDirectionCommand}" CommandParameter="Until">
                                        <Label Text="{loc:Tr Form_CountingUntil}" FontFamily="FigtreeSemiBold" FontSize="12.5" HorizontalOptions="Center" VerticalOptions="Center"
                                               InputTransparent="True" Style="{StaticResource SecondaryText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsUntilSelected}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </dc:HoverSurface>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{loc:Tr Form_Date}" Style="{StaticResource DeskFieldLabel}" />
                            <Border Style="{StaticResource DeskInput}" Padding="4,0">
                                <DatePicker Date="{Binding AnchorDate}" Format="d MMM yyyy" FontFamily="PlexMonoMedium" FontSize="13.5" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{loc:Tr Form_Pin}" Style="{StaticResource DeskFieldLabel}" />
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" MinimumHeightRequest="38">
                                <dc:DeskToggle IsToggled="{Binding IsPinned}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{loc:Tr Form_PinToTopDesktop}" FontFamily="FigtreeMedium" FontSize="13.5" />
                                    <Label Text="{loc:Tr Form_PinToHomeSub}" FontSize="12" Style="{StaticResource SecondaryText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Tr Form_Notes}" Style="{StaticResource DeskFieldLabel}" />
                        <Border Style="{StaticResource DeskInput}" Padding="10,2">
                            <Editor Text="{Binding Notes}" Placeholder="{loc:Tr Form_NotesPlaceholder}" HeightRequest="80" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{loc:Tr Form_Colour}" Style="{StaticResource DeskFieldLabel}" />
                        <dc:SwatchGrid Choices="{Binding ColorChoices}" SelectCommand="{Binding SelectColorCommand}" Margin="-4,0,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Validation renders inline above the footer -->
            <Grid Grid.Row="2" Padding="26,2,26,12" ColumnDefinitions="Auto,*" ColumnSpacing="9"
                  IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}">
                <c:SvgIcon Glyph="WinWarning" Size="15" VerticalOptions="Center"
                           Color="{AppThemeBinding Light={StaticResource DangerLight}, Dark={StaticResource DangerDark}}" />
                <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontFamily="FigtreeMedium" FontSize="13" Style="{StaticResource DangerText}" />
            </Grid>

            <Grid Grid.Row="3" RowDefinitions="1,Auto">
                <BoxView />
                <Grid Grid.Row="1" Padding="26,14,26,18" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9"
                      BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                    <Button Grid.Column="1" Text="{loc:Tr Common_Cancel}" Style="{StaticResource DeskTonalButton}" HeightRequest="38" Command="{Binding CancelCommand}" />
                    <Button Grid.Column="2" Text="{Binding SaveLabel}" Style="{StaticResource DeskPrimaryButton}" HeightRequest="38"
                            AutomationId="form-save" Command="{Binding SaveCommand}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>
