<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Markd.Controls"
             xmlns:dc="clr-namespace:Markd.Desktop.Controls"
             x:Class="Markd.Desktop.Dialogs.ToastCard">
    <!-- InfoBar-style toast: 336 wide, radius 9, check badge, title + detail, close button -->
    <Border Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 9" WidthRequest="336" Padding="15,14,12,14">
        <Border.Shadow>
            <Shadow Brush="{StaticResource DesktopShadowBrush}" Offset="0,10" Radius="28" />
        </Border.Shadow>
        <Grid ColumnDefinitions="22,*,22" ColumnSpacing="11">
            <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" VerticalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}">
                <c:SvgIcon Glyph="WinCheck" Size="13" Color="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label x:Name="TitleLabel" FontFamily="FigtreeSemiBold" FontSize="13.5" />
                <Label x:Name="DetailLabel" FontSize="12.5" LineHeight="1.3" Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <dc:DeskButton Grid.Column="2" Variant="Subtle" Glyph="WinClose" GlyphSize="11" WidthRequest="22" HeightRequest="22"
                           CornerRadius="5" ContentKey="TextTertiary" VerticalOptions="Start" Clicked="OnCloseClicked" />
        </Grid>
    </Border>
</ContentView>
