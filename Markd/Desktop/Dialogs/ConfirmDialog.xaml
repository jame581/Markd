<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Markd.Desktop.Dialogs.ConfirmDialog">
    <!-- ContentDialog: 440 wide, radius 10, the actions on a page-coloured footer band -->
    <Border Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 10" WidthRequest="440">
        <VerticalStackLayout>
            <VerticalStackLayout Padding="26,24,26,20" Spacing="9">
                <Label x:Name="TitleLabel" FontFamily="FigtreeSemiBold" FontSize="19" LineHeight="1.2" />
                <Label x:Name="MessageLabel" FontSize="14" LineHeight="1.45" Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <Grid Padding="26,18,26,22" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource DeskTonalButton}" Clicked="OnCancelClicked" />
                <Button x:Name="AcceptButton" Grid.Column="2" Style="{StaticResource DeskPrimaryButton}" Clicked="OnAcceptClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
