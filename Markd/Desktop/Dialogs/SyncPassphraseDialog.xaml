<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Desktop.Dialogs.SyncPassphraseDialog">
    <Border Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 10" WidthRequest="460">
        <VerticalStackLayout>
            <VerticalStackLayout Padding="26,24,26,20" Spacing="10">
                <Label x:Name="TitleLabel" FontFamily="FigtreeSemiBold" FontSize="19" />
                <Label x:Name="MessageLabel" FontSize="14" LineHeight="1.35" Style="{StaticResource SecondaryText}" />
                <Label Text="{loc:Tr Sync_PassphraseField}" FontSize="12.5" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                <Entry x:Name="PassphraseEntry" IsPassword="True" FontSize="14" Completed="OnPassphraseCompleted" />
                <VerticalStackLayout x:Name="RepeatPanel" Spacing="10" IsVisible="False">
                    <Label Text="{loc:Tr Sync_PassphraseRepeat}" FontSize="12.5" Style="{StaticResource SecondaryText}" />
                    <Entry x:Name="RepeatEntry" IsPassword="True" FontSize="14" Completed="OnContinueClicked" />
                </VerticalStackLayout>
                <Label x:Name="ErrorLabel" Style="{StaticResource DangerText}" FontSize="12.5" IsVisible="False" />
                <Label x:Name="WarningLabel" Text="{loc:Tr Sync_SetupWarning}" FontSize="12.5" LineHeight="1.4"
                       Style="{StaticResource SecondaryText}" IsVisible="False" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <Grid Padding="26,18,26,22" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Button x:Name="ForgotButton" Text="{loc:Tr Sync_PassphraseForgot}" Style="{StaticResource DeskTextButton}"
                        VerticalOptions="Center" Margin="-10,0,0,0" IsVisible="False" Clicked="OnForgotClicked" />
                <Button Grid.Column="2" Text="{loc:Tr Common_Cancel}" Style="{StaticResource DeskTonalButton}" Clicked="OnCancelClicked" />
                <Button Grid.Column="3" Text="{loc:Tr Sync_PassphraseContinue}" Style="{StaticResource DeskPrimaryButton}" Clicked="OnContinueClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
