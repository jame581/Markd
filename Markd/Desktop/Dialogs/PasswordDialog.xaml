<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Desktop.Dialogs.PasswordDialog">
    <Border Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 10" WidthRequest="440">
        <VerticalStackLayout>
            <VerticalStackLayout Padding="26,24,26,20" Spacing="10">
                <Label Text="{loc:Tr Import_PasswordTitle}" FontFamily="FigtreeSemiBold" FontSize="19" />
                <Label x:Name="MessageLabel" FontSize="14" Style="{StaticResource SecondaryText}" />
                <Entry x:Name="PasswordEntry" IsPassword="True" FontSize="14" Completed="OnOpenClicked" />
                <Label x:Name="ErrorLabel" Text="{loc:Tr Import_WrongPassword}" Style="{StaticResource DangerText}" FontSize="12.5" IsVisible="False" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <Grid Padding="26,18,26,22" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="9"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Button Grid.Column="1" Text="{loc:Tr Common_Cancel}" Style="{StaticResource DeskTonalButton}" Clicked="OnCancelClicked" />
                <Button Grid.Column="2" Text="{loc:Tr Import_Open}" Style="{StaticResource DeskPrimaryButton}" Clicked="OnOpenClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
