<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:dc="clr-namespace:Markd.Desktop.Controls"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Desktop.Dialogs.ExportOptionsDialog"
             x:DataType="vm:ExportOptionsForm">
    <Border Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 10" WidthRequest="460">
        <VerticalStackLayout>
            <VerticalStackLayout Padding="26,24,26,20" Spacing="14">
                <Label Text="{loc:Tr Export_Title}" FontFamily="FigtreeSemiBold" FontSize="19" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{loc:Tr Export_Encrypt}" FontSize="14" VerticalOptions="Center" />
                    <dc:DeskToggle Grid.Column="1" IsToggled="{Binding Encrypt}" />
                </Grid>
                <VerticalStackLayout Spacing="10" IsVisible="{Binding Encrypt}">
                    <Label Text="{loc:Tr Export_Password}" FontSize="12.5" Style="{StaticResource SecondaryText}" />
                    <Entry x:Name="PasswordEntry" Text="{Binding Password}" IsPassword="True" FontSize="14" />
                    <Label Text="{loc:Tr Export_ConfirmPassword}" FontSize="12.5" Style="{StaticResource SecondaryText}" />
                    <Entry Text="{Binding ConfirmPassword}" IsPassword="True" FontSize="14" />
                    <Label Text="{loc:Tr Export_PasswordWarning}" FontSize="12.5" LineHeight="1.4" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource DangerText}" FontSize="12.5"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <Grid Padding="26,18,26,22" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9"
                  BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
                <Button Grid.Column="1" Text="{loc:Tr Common_Cancel}" Style="{StaticResource DeskTonalButton}" Clicked="OnCancelClicked" />
                <Button Grid.Column="2" Text="{loc:Tr Export_Share}" Style="{StaticResource DeskTonalButton}" Clicked="OnShareClicked" />
                <Button Grid.Column="3" Text="{loc:Tr Export_SaveTo}" Style="{StaticResource DeskPrimaryButton}" Clicked="OnSaveClicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
