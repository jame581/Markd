<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:dc="clr-namespace:Markd.Desktop.Controls"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Desktop.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <ContentView.Resources>
        <Style x:Key="AboutLink" TargetType="Label">
            <Setter Property="FontFamily" Value="FigtreeMedium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentTextLight}, Dark={StaticResource AccentTextDark}}" />
        </Style>
        <Style x:Key="AboutValue" TargetType="Label">
            <Setter Property="FontFamily" Value="FigtreeMedium" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentView.Resources>

    <ScrollView>
        <dc:CappedColumn MaxColumnWidth="712">
            <VerticalStackLayout Padding="26,18,26,40" Spacing="12">
                <Border Style="{StaticResource DeskCard}" StrokeShape="RoundRectangle 14" Padding="30,28">
                    <Grid ColumnDefinitions="82,*" ColumnSpacing="24">
                        <Border WidthRequest="82" HeightRequest="82" StrokeShape="RoundRectangle 20" VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}">
                            <Label Text="M" FontFamily="FigtreeExtraBold" FontSize="40" TextColor="{StaticResource White}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="Markd" FontFamily="FigtreeBold" FontSize="24" />
                            <Label Text="{Binding VersionText}" FontFamily="PlexMonoMedium" FontSize="13" Style="{StaticResource SecondaryText}" />
                            <Label Text="{loc:Tr About_Description}"
                                   FontSize="14" LineHeight="1.4" Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource DeskCard}" Padding="20,18">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{loc:Tr About_Licence}" Style="{StaticResource DeskCardHeader}" />
                            <Label Text="{loc:Tr About_LicenceValue}" Style="{StaticResource AboutValue}" />
                            <Label Text="{loc:Tr About_LicenceLink}" Style="{StaticResource AboutLink}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenLicenceCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource DeskCard}" Padding="20,18">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{loc:Tr About_SourceCode}" Style="{StaticResource DeskCardHeader}" />
                            <Label Text="{loc:Tr About_SourceValue}" Style="{StaticResource AboutValue}" />
                            <Label Text="{loc:Tr About_SourceLink}" Style="{StaticResource AboutLink}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSourceCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource DeskCard}" Padding="20,18">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{loc:Tr About_Translations}" Style="{StaticResource DeskCardHeader}" />
                            <Label Text="{loc:Tr Settings_LanguageSub}" Style="{StaticResource AboutValue}" />
                            <Label Text="{loc:Tr About_TranslationsLink}" Style="{StaticResource AboutLink}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSourceCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DeskCard}" Padding="20,18">
                        <VerticalStackLayout Spacing="7">
                            <Label Text="{loc:Tr About_Acknowledgements}" Style="{StaticResource DeskCardHeader}" />
                            <Label Text="{loc:Tr About_AckValue}" Style="{StaticResource AboutValue}" />
                            <Label Text="{loc:Tr About_AckLink}" Style="{StaticResource AboutLink}">
                                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowAcknowledgementsCommand}" /></Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="{loc:Tr About_FooterDesktop}" FontSize="12.5" Margin="2,4,0,0"
                       Style="{StaticResource TertiaryText}" />
            </VerticalStackLayout>
        </dc:CappedColumn>
    </ScrollView>
</ContentView>
