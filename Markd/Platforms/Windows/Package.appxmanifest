<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap com desktop">

  <!-- Identity, Publisher and PublisherDisplayName are the Product identity Partner Center assigned
       (package family 21441Mesarc.MarkdDayCounter_r7cvsd1wfgvb0). Version stays 0.0.0.0 so MAUI
       fills it from ApplicationDisplayVersion. -->
  <Identity Name="21441Mesarc.MarkdDayCounter" Publisher="CN=68156E3E-964C-4233-B256-D9D053C0DBC1" Version="0.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="233B261C-93F9-43AF-AC7A-4EA637A18E6C" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <!-- The Store requires this to match the reserved name exactly, so it is written out rather
         than left to the $placeholder$ token MAUI fills from ApplicationTitle. -->
    <DisplayName>Markd Day Counter</DisplayName>
    <PublisherDisplayName>Jan Mesarč</PublisherDisplayName>
    <Logo>$placeholder$.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Desktop only: Markd is a full-trust Win32 app and cannot run on other device families. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <!-- Listed explicitly: the translations are .resx satellite assemblies, which x-generate cannot see,
         so it would declare English only. Keep in step with SatelliteResourceLanguages in Markd.csproj. -->
    <Resource Language="en-US" />
    <Resource Language="cs-CZ" />
    <Resource Language="de-DE" />
    <Resource Language="fr-FR" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="$placeholder$"
        Description="$placeholder$"
        Square150x150Logo="$placeholder$.png"
        Square44x44Logo="$placeholder$.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Square71x71Logo="$placeholder$.png" Wide310x150Logo="$placeholder$.png" Square310x310Logo="$placeholder$.png" />
        <uap:SplashScreen Image="$placeholder$.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- A click on a milestone toast activates this CLSID; Windows App SDK routes it to AppNotificationManager. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="3736A808-35D3-4A91-AE55-99713C056494" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <!-- Named literally: MAUI does not substitute $targetnametoken$ inside com:ExeServer. -->
            <com:ExeServer Executable="Markd.exe" DisplayName="Markd Day Counter" Arguments="----AppNotificationActivated:">
              <com:Class Id="3736A808-35D3-4A91-AE55-99713C056494" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
