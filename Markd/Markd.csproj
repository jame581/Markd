<Project Sdk="Microsoft.NET.Sdk">

	<!-- Untracked cloud client ids (see Markd.Secrets.props.example). Absent means the providers are left out. -->
	<Import Project="..\Markd.Secrets.props" Condition="Exists('..\Markd.Secrets.props')" />

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Markd</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SatelliteResourceLanguages>en;cs;de;fr</SatelliteResourceLanguages>


		<!-- Display name -->
		<ApplicationTitle>Markd Day Counter</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.janmesarc.markd</ApplicationId>

		<!-- Versions: a release tag must be v + ApplicationDisplayVersion. CI sets ApplicationVersion to the run number. -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Unpackaged by default, which is what the GitHub release zip ships. The Store needs a
		     packaged build, so the microsoft-store release job overrides this to MSIX. Milestone toasts
		     need package identity, so test them locally with -p:WindowsPackageType=MSIX. -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">29.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<!-- The symbol package needs mspdbcmf.exe from the Visual Studio C++ tooling and fails the build without it. -->
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<!-- Shown in the file properties of Markd.exe. -->
		<Product>Markd Day Counter</Product>
		<Company>Jan Mesarč</Company>
		<Copyright>© 2026 Jan Mesarč</Copyright>
		<Description>Counts the days since or until the dates that matter, with milestones.</Description>
		<RepositoryUrl>https://github.com/jame581/Markd</RepositoryUrl>
	</PropertyGroup>

	<!-- Local sideload packages are signed with a developer's own gitignored test certificate when it exists.
	     The Store package is uploaded unsigned (Partner Center signs it), so CI never has the key. -->
	<PropertyGroup Condition="Exists('Markd_TemporaryKey.pfx')">
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<PackageCertificateKeyFile>Markd_TemporaryKey.pfx</PackageCertificateKeyFile>
	</PropertyGroup>

	<ItemGroup>

		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#6F63C9" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B0F14" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<!-- Pinned to 10.0.100: Resizetizer 10.0.101 fails on SVGs with <text> (splash.svg), dotnet/maui#38507. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
		<PackageReference Include="Plugin.LocalNotification" Version="14.1.2" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13" />
	</ItemGroup>

	<!-- DPAPI for the sync passphrase file (Platforms/Windows/DpapiSyncSecretStore.cs). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
	  <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
	</ItemGroup>

	<!-- Google sign-in on Android (AuthorizationClient, Platforms/Android/GoogleAndroidAuthService.cs). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
	  <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="122.0.0" />
	  <!-- It lifts Fragment, Lifecycle and Collection past the versions MAUI's own -ktx packages pin, which puts the same
	       classes in two jars (D8 "defined multiple times"). These keep the -ktx packages in step with what it resolves. -->
	  <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
	  <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	</ItemGroup>

	<!-- Microsoft sign-in for OneDrive (Services/Sync/MsalAuthService.cs) on Android and Windows. The cache helper
	     (DPAPI token cache file) is only used on Windows: MSAL keeps its own cache on Android. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
	  <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
	</ItemGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
	  <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Markd.Core\Markd.Core.csproj" />
	</ItemGroup>

	<!-- Read by Services/AppVersion.cs, so every platform shows the same version. -->
	<ItemGroup>
	  <AssemblyMetadata Include="Markd.Version" Value="$(ApplicationDisplayVersion)" />
	  <AssemblyMetadata Include="Markd.Build" Value="$(ApplicationVersion)" />
	</ItemGroup>

	<!-- The desktop shell (rail, two panes, overlays) only exists on Windows. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
	  <Compile Remove="Desktop\**" />
	  <MauiXaml Remove="Desktop\**" />
	  <None Include="Desktop\**" />
	</ItemGroup>

	<!-- OneDrive is only offered on Android and Windows, so iOS and Mac Catalyst build without MSAL. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
	  <Compile Remove="Services\Sync\MsalAuthService.cs" />
	  <None Include="Services\Sync\MsalAuthService.cs" />
	</ItemGroup>

	<!-- Bakes the optional cloud client ids into Services/Sync/CloudConfig. Empty means not configured. Runs before
	     XamlPreCompile too: the WinUI XAML compiler builds a first pass of the assembly before BeforeCompile. -->
	<Target Name="GenerateCloudConfig" BeforeTargets="XamlPreCompile;CoreCompile;BeforeCompile">
		<PropertyGroup>
			<_CloudConfigFile>$(IntermediateOutputPath)CloudConfig.g.cs</_CloudConfigFile>
			<_CfgGoogleId>$(MarkdGoogleDesktopClientId.Replace('\', '\\').Replace('&quot;', '\&quot;'))</_CfgGoogleId>
			<_CfgGoogleSecret>$(MarkdGoogleDesktopClientSecret.Replace('\', '\\').Replace('&quot;', '\&quot;'))</_CfgGoogleSecret>
			<_CfgMicrosoftId>$(MarkdMicrosoftClientId.Replace('\', '\\').Replace('&quot;', '\&quot;'))</_CfgMicrosoftId>
		</PropertyGroup>
		<ItemGroup>
			<_CloudConfigLine Include="// &lt;auto-generated /&gt;" />
			<_CloudConfigLine Include="namespace Markd.Services.Sync%3B" />
			<_CloudConfigLine Include="internal static class CloudConfig" />
			<_CloudConfigLine Include="{" />
			<_CloudConfigLine Include="public const string GoogleDesktopClientId = &quot;$(_CfgGoogleId)&quot;%3B" />
			<_CloudConfigLine Include="public const string GoogleDesktopClientSecret = &quot;$(_CfgGoogleSecret)&quot;%3B" />
			<_CloudConfigLine Include="public const string MicrosoftClientId = &quot;$(_CfgMicrosoftId)&quot;%3B" />
			<_CloudConfigLine Include="public static bool HasGoogleDesktop =&gt; GoogleDesktopClientId.Length &gt; 0%3B" />
			<_CloudConfigLine Include="public static bool HasMicrosoft =&gt; MicrosoftClientId.Length &gt; 0%3B" />
			<_CloudConfigLine Include="}" />
		</ItemGroup>
		<WriteLinesToFile File="$(_CloudConfigFile)" Lines="@(_CloudConfigLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(_CloudConfigFile)" />
			<FileWrites Include="$(_CloudConfigFile)" />
		</ItemGroup>
	</Target>

</Project>
