<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:c="clr-namespace:Markd.Controls"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             x:Class="Markd.OccasionDetailPage"
             x:Name="RootPage"
             x:DataType="vm:OccasionDetailViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <m:SmallTopAppBar Title="{Binding Title}">
            <HorizontalStackLayout Spacing="0">
                <c:IconButton Glyph="Pencil" IconSize="20" Command="{Binding EditCommand}" />
                <c:IconButton x:Name="OverflowButton" Glyph="Dots" IconSize="20" Clicked="OnOverflowClicked" />
            </HorizontalStackLayout>
        </m:SmallTopAppBar>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,6,16,24" Spacing="18">

                <Border x:Name="HeroCard"
                        Style="{StaticResource M3TonalCard}"
                        StrokeShape="RoundRectangle 24"
                        Padding="22,26">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{Binding DisplayDays}"
                                   Style="{StaticResource M3OnContainer}"
                                   FontFamily="FigtreeExtraBold" FontSize="80" CharacterSpacing="-0.64"
                                   LineHeight="0.9" />
                            <Label Text="{Binding UnitLabel}"
                                   Style="{StaticResource M3OnContainer}"
                                   FontFamily="FigtreeSemiBold" FontSize="22" Opacity="0.72"
                                   VerticalOptions="End" Margin="0,0,0,12" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding TimeBreakdown}"
                               Style="{StaticResource M3OnContainer}"
                               FontFamily="PlexMonoMedium" FontSize="13.5" Opacity="0.8"
                               HorizontalOptions="Center" />
                        <Border Margin="0,10,0,0"
                                StrokeShape="RoundRectangle 9"
                                Padding="13,7"
                                HorizontalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource OnContainerChipLight}, Dark={StaticResource OnContainerChipDark}}">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding DirectionChipText}"
                                       Style="{StaticResource M3OnContainer}"
                                       FontFamily="FigtreeSemiBold" FontSize="11.5" CharacterSpacing="1.6"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding AnchorShort}"
                                       Style="{StaticResource M3OnContainer}"
                                       FontFamily="FigtreeMedium" FontSize="12.5" Opacity="0.85"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding NotesText}"
                       Style="{StaticResource M3Body}"
                       Padding="4,0"
                       IsVisible="{Binding HasNotes}" />

                <VerticalStackLayout Spacing="9">
                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                        <Label Text="Milestones" Style="{StaticResource M3SectionHeader}" VerticalOptions="Center" />
                        <Border Grid.Column="1"
                                HeightRequest="32"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1"
                                Padding="13,0"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddMilestoneCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <c:SvgIcon Glyph="Plus" Size="15" VerticalOptions="Center"
                                           Color="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                                <Label Text="Add" FontFamily="FigtreeSemiBold" FontSize="13" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="No milestones yet. Add one to get a heads-up on the day it lands."
                           Style="{StaticResource M3RowSub}"
                           Padding="4,0"
                           IsVisible="{Binding HasMilestones, Converter={StaticResource InvertBool}}" />

                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding MilestoneStates}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MilestoneViewState">
                                <Border Style="{StaticResource M3Card}" Padding="16,13">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMilestoneTapped" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Grid WidthRequest="34" HeightRequest="34" VerticalOptions="Center">
                                            <Border StrokeShape="RoundRectangle 17" IsVisible="{Binding IsReached}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}">
                                                <c:SvgIcon Glyph="Tick" Size="17" HorizontalOptions="Center" VerticalOptions="Center"
                                                           Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                                            </Border>
                                            <Border StrokeShape="RoundRectangle 17" IsVisible="{Binding IsUpcoming}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceContainerHighLight}, Dark={StaticResource SurfaceContainerHighDark}}">
                                                <c:SvgIcon Glyph="Flag" Size="17" HorizontalOptions="Center" VerticalOptions="Center"
                                                           Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                            </Border>
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Label}" Style="{StaticResource M3RowTitle}" FontSize="15.5" />
                                            <Label Text="{Binding StatusText}" Style="{StaticResource M3RowSub}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding ThresholdText}"
                                               Style="{StaticResource BreakdownLabel}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12" Margin="0,6,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="{Binding PinButtonText}"
                                Style="{StaticResource M3FilledButton}"
                                Command="{Binding PinCommand}" />
                        <Button Grid.Column="1"
                                Text="Share"
                                Style="{StaticResource M3TonalButton}"
                                Command="{Binding ShareCommand}" />
                    </Grid>
                    <Button Text="Delete occasion"
                            Style="{StaticResource M3ErrorTextButton}"
                            HorizontalOptions="Center"
                            Command="{Binding DeleteCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
