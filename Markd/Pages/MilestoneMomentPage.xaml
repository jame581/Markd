<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Markd.Services"
             xmlns:c="clr-namespace:Markd.Controls"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Pages.MilestoneMomentPage"
             x:DataType="services:MilestoneMoment"
             Style="{StaticResource M3DialogPage}"
             Shell.PresentationMode="ModalNotAnimated">
    <Grid>
        <Border x:Name="Card" Style="{StaticResource M3DialogCard}" Padding="26,30,26,20">
            <VerticalStackLayout Spacing="12">
                <Grid WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                    <Border x:Name="RingA" StrokeShape="RoundRectangle 48" StrokeThickness="2" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                    <Border x:Name="RingB" StrokeShape="RoundRectangle 48" StrokeThickness="2" BackgroundColor="Transparent"
                            Stroke="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                    <Border WidthRequest="74" HeightRequest="74" StrokeShape="RoundRectangle 37"
                            HorizontalOptions="Center" VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryContainerLight}, Dark={StaticResource PrimaryContainerDark}}">
                        <Label Text="{Binding Occasion.Emoji, TargetNullValue='🎉'}" FontSize="34"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
                <Label Text="{loc:Tr Milestone_Reached}"
                       FontFamily="FigtreeSemiBold" FontSize="11.5" CharacterSpacing="2.24"
                       HorizontalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource AccentFillLight}, Dark={StaticResource AccentFillDark}}" />
                <Label Text="{Binding Number}"
                       FontFamily="FigtreeExtraBold" FontSize="46" CharacterSpacing="-0.48"
                       HorizontalOptions="Center" LineHeight="0.95" />
                <Label Text="{Binding Milestone.Label}"
                       FontFamily="FigtreeBold" FontSize="19"
                       HorizontalTextAlignment="Center" />
                <Label Text="{Binding Sentence}"
                       Style="{StaticResource M3RowSub}" FontSize="14.5"
                       HorizontalTextAlignment="Center" />
                <HorizontalStackLayout Spacing="6" HorizontalOptions="End" Margin="0,8,0,0">
                    <Button Text="{loc:Tr Milestone_NotNow}" Style="{StaticResource M3TextButton}" Clicked="OnNotNowClicked" />
                    <Button Text="{loc:Tr Milestone_ShareThis}" Style="{StaticResource M3FilledButton}" HeightRequest="42" CornerRadius="21"
                            FontSize="14.5" Clicked="OnShareClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
