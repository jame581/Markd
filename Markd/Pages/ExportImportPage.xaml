<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Markd.Pages.ExportImportPage"
             Title="Import / Export">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="JSON Import / Export" FontSize="18" FontAttributes="Bold" />
            <Label Text="Export creates a JSON backup and opens the share sheet. Import lets you pick a JSON file and replaces the current app data with its contents." />

            <Button Text="Export JSON" Command="{Binding ExportJsonCommand}" />
            <Button Text="Import JSON" Command="{Binding ImportJsonCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="Status" FontAttributes="Bold" />
            <Label Text="{Binding Status}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
