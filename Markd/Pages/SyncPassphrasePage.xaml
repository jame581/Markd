<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Pages.SyncPassphrasePage"
             Style="{StaticResource M3DialogPage}"
             Shell.PresentationMode="ModalNotAnimated">
    <Grid>
        <Border Style="{StaticResource M3DialogCard}" Padding="24,24,16,14">
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6" Padding="0,0,8,0">
                    <Label x:Name="TitleLabel" FontFamily="FigtreeSemiBold" FontSize="22" />
                    <Label x:Name="MessageLabel" Style="{StaticResource M3RowSub}" FontSize="14" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="14" Padding="0,0,8,0">
                    <m:OutlinedField Label="{loc:Tr Sync_PassphraseField}">
                        <Entry x:Name="PassphraseEntry" IsPassword="True" FontSize="16" Completed="OnPassphraseCompleted" />
                    </m:OutlinedField>
                    <m:OutlinedField x:Name="RepeatField" Label="{loc:Tr Sync_PassphraseRepeat}" IsVisible="False">
                        <Entry x:Name="RepeatEntry" IsPassword="True" FontSize="16" Completed="OnOkClicked" />
                    </m:OutlinedField>
                    <Label x:Name="ErrorLabel" Style="{StaticResource DangerText}" FontSize="13" IsVisible="False" />
                    <Label x:Name="WarningLabel" Text="{loc:Tr Sync_SetupWarning}" Style="{StaticResource M3RowSub}" FontSize="13" IsVisible="False" />
                </VerticalStackLayout>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button x:Name="ForgotButton" Text="{loc:Tr Sync_PassphraseForgot}" Style="{StaticResource M3TextButton}" Padding="10,0"
                            IsVisible="False" Clicked="OnForgotClicked" />
                    <HorizontalStackLayout Grid.Column="2" Spacing="6">
                        <Button Text="{loc:Tr Common_Cancel}" Style="{StaticResource M3TextButton}" Clicked="OnCancelClicked" />
                        <Button Text="{loc:Tr Sync_PassphraseContinue}" Style="{StaticResource M3FilledButton}" HeightRequest="42" CornerRadius="21"
                                FontSize="14.5" Clicked="OnOkClicked" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
