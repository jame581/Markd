             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             x:Class="Markd.Pages.ConflictComparePage"
             Shell.NavBarIsVisible="False"
             Shell.PresentationMode="ModalNotAnimated">
