<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Pages.PasswordPage"
             Style="{StaticResource M3DialogPage}"
             Shell.PresentationMode="ModalNotAnimated">
    <Grid>
        <Border Style="{StaticResource M3DialogCard}" Padding="24,24,16,14">
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6" Padding="0,0,8,0">
                    <Label Text="{loc:Tr Import_PasswordTitle}" FontFamily="FigtreeSemiBold" FontSize="22" />
                    <Label x:Name="MessageLabel" Style="{StaticResource M3RowSub}" FontSize="14" />
                </VerticalStackLayout>
                <m:OutlinedField Label="{loc:Tr Export_Password}" Margin="0,0,8,0">
                    <Entry x:Name="PasswordEntry" IsPassword="True" FontSize="16" Completed="OnOpenClicked" />
                </m:OutlinedField>
                <Label x:Name="ErrorLabel" Text="{loc:Tr Import_WrongPassword}" Style="{StaticResource DangerText}" FontSize="13" IsVisible="False" />
                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                    <Button Text="{loc:Tr Common_Cancel}" Style="{StaticResource M3TextButton}" Clicked="OnCancelClicked" />
                    <Button Text="{loc:Tr Import_Open}" Style="{StaticResource M3FilledButton}" HeightRequest="42" CornerRadius="21"
                            FontSize="14.5" Clicked="OnOpenClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
