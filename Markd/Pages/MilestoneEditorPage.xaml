<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Markd.Pages.MilestoneEditorPage"
             BackgroundColor="#66000000"
             Shell.NavBarIsVisible="False">
    <Grid Padding="24">
        <Border MaximumWidthRequest="360"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight},
                                                  Dark={StaticResource SurfaceCardDark}}"
                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight},
                                         Dark={StaticResource CardBorderDark}}"
                StrokeShape="RoundRectangle 24"
                Padding="22">
            <VerticalStackLayout Spacing="16">
                <Border WidthRequest="38"
                        HeightRequest="5"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBorderLight},
                                                          Dark={StaticResource CardBorderDark}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 3" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Add milestone"
                           FontFamily="FigtreeSemiBold"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                       Dark={StaticResource TextPrimaryDark}}" />
                    <Label Text="Capture the next count without shifting the milestone list."
                           Style="{StaticResource RowSubtitle}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Label"
                           Style="{StaticResource Overline}" />
                    <Entry x:Name="LabelEntry"
                           Placeholder="Fifteen hundred" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Threshold days"
                           Style="{StaticResource Overline}" />
                    <Entry x:Name="ThresholdEntry"
                           Keyboard="Numeric"
                           Placeholder="1500" />
                </VerticalStackLayout>

                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       TextColor="{AppThemeBinding Light={StaticResource DangerLight},
                                                   Dark={StaticResource DangerDark}}" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <Button Text="Cancel"
                            Style="{StaticResource TonalButton}"
                            Clicked="OnCancelClicked" />
                    <Button Grid.Column="1"
                            Text="Save"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnSaveClicked" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
