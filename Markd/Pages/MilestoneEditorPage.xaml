<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Markd.ViewModels"
             xmlns:m="clr-namespace:Markd.Controls.Mobile"
             xmlns:loc="clr-namespace:Markd.Localization"
             x:Class="Markd.Pages.MilestoneEditorPage"
             x:DataType="vm:MilestoneEditorViewModel"
             Style="{StaticResource M3DialogPage}"
             Shell.PresentationMode="ModalNotAnimated">
    <Grid>
        <Border Style="{StaticResource M3DialogCard}" Padding="24,24,16,14">
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout Spacing="6" Padding="0,0,8,0">
                    <Label Text="{loc:Tr Milestone_AddTitle}" FontFamily="FigtreeSemiBold" FontSize="22" />
                    <Label Text="{loc:Tr Milestone_AddHint}"
                           Style="{StaticResource M3RowSub}" FontSize="14" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14" Padding="0,0,8,0">
                    <m:OutlinedField Label="{loc:Tr Milestone_Name}">
                        <Entry x:Name="LabelEntry" Text="{Binding Label}" Placeholder="{loc:Tr Milestone_NamePlaceholder}" FontSize="16" />
                    </m:OutlinedField>
                    <m:OutlinedField Label="{loc:Tr Milestone_Days}">
                        <Entry x:Name="ThresholdEntry" Text="{Binding ThresholdDays}" Placeholder="{loc:Tr Milestone_DaysPlaceholder}"
                               Keyboard="Numeric" FontFamily="PlexMonoMedium" FontSize="16" />
                    </m:OutlinedField>
                    <Label Text="{Binding ErrorMessage}"
                           Style="{StaticResource DangerText}" FontSize="13"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource HasText}}" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="6" HorizontalOptions="End">
                    <Button Text="{loc:Tr Common_Cancel}" Style="{StaticResource M3TextButton}" Clicked="OnCancelClicked" />
                    <Button Text="{loc:Tr Milestone_Add}" Style="{StaticResource M3FilledButton}" HeightRequest="42" CornerRadius="21"
                            FontSize="14.5" Clicked="OnSaveClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
